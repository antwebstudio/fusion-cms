{
    "name": "fusioncms/cms",
    "description": "Core of FusionCMS",
    "license": "MIT",
    "authors": [
        {
            "name": "Shea Lewis (Kai)",
            "email": "shea.lewis89@gmail.com"
        }
    ],
    "autoload": {
        "classmap": [
            "database/"
        ],
        "psr-4": {
            "Fusion\\": "src/"
        },
        "files": [
            "helpers/app.php",
            "helpers/blade.php",
            "helpers/datetime.php",
            "helpers/fields.php",
            "helpers/forms.php",
            "helpers/integers.php",
            "helpers/matrix.php",
            "helpers/menus.php",
            "helpers/misc.php",
            "helpers/paths.php",
            "helpers/relationships.php",
            "helpers/seo.php",
            "helpers/settings.php",
            "helpers/strings.php",
            "helpers/themes.php",
            "helpers/users.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/stubs/laravel/themes"
        ],
        "psr-4": {
            "Fusion\\Tests\\": "tests/src/",
            "App\\": "tests/stubs/laravel/app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "biscolab/laravel-recaptcha": "^6.0",
        "composer/semver": "^3.0",
        "illuminate/support": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.24|^11.0",
        "laravel/ui": "^4.6",
        "league/glide": "^2.0|^3.0",
        "league/glide-symfony": "^2.0|^3.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-analytics": "^5.7",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-query-builder": "^6.4",
        "spatie/laravel-searchable": "^1.13",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/mailgun-mailer": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "symfony/css-selector": "^7.4|^8.0",
        "symfony/dom-crawler": "^7.4|^8.0"
    },
    "repositories": [],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fusion\\Providers\\FusionServiceProvider"
            ],
            "aliases": {
                "Addon": "Fusion\\Facades\\Addon",
                "Theme": "Fusion\\Facades\\Theme",
                "Fusion": "Fusion\\Facades\\Fusion",
                "Setting": "Fusion\\Facades\\Setting"
            }
        }
    }
}
